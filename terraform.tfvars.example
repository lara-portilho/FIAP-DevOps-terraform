aws_region   = "us-east-1"
project_name = "togglemaster"
environment  = "production"

# EKS
eks_node_instance_type = "m7i-flex.large" # Free Tier eligible; t3.medium e bloqueado no plano gratuito
eks_node_min           = 1
eks_node_desired       = 2
eks_node_max           = 2

# RDS
db_instance_class = "db.t3.micro"
db_username       = "postgres"
db_password       = "CHANGE_ME_strong_password_123"
